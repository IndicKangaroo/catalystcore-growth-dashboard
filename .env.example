# Copy to .env for local development. Never commit .env or any key file.

NODE_ENV=development
PORT=8787

# Where the browser app is served from (used for CORS).
WEB_ORIGIN=http://localhost:5173

# Analytics source: "seed" (labeled demo data) or "ga4" (real GA4 Data API).
ANALYTICS_PROVIDER=seed

# --- GA4 (only with ANALYTICS_PROVIDER=ga4) -------------------------------------------------
# API: the FULL path of the service account key file that reads GA4. Add that account's email as a
# Viewer on every GA4 property (GA4 Admin, Property access management) and enable the "Google
# Analytics Data API" in the key's Google Cloud project. If empty, GOOGLE_APPLICATION_CREDENTIALS
# below is used. Never commit the key file. Check one property with: npm run ga4:check -- <id>
GA4_SERVICE_ACCOUNT_KEY_FILE=

# --- Sign-in and database (Firebase) ------------------------------------------------------
# Leave these empty to run without sign-in: protected API routes then answer 503
# "auth_not_configured" and the web app shows setup help. README: "Sign-in (Firebase)".

# API: the Firebase project this deployment uses. Make a project just for the dashboard; do not
# reuse the project of one of your apps (README: "Option B").
FIREBASE_PROJECT_ID=
# API, local development against a real project: the FULL path of a service account key file
# (Firebase console, Project settings, Service accounts, Generate new private key), for example
# /home/you/keys/growth-admin.json (on Windows: C:/Users/you/keys/growth-admin.json). Without a
# key, or `gcloud auth application-default login`, nobody can sign in. Not needed with the
# emulators. In production on Cloud Run, leave this empty and use the runtime service account.
# Restart `npm run dev` after changing anything in this file.
GOOGLE_APPLICATION_CREDENTIALS=
# API: the first admin. This email becomes an admin the first time it signs in.
# Admins invite everyone else from the Users screen.
ADMIN_EMAIL=

# Web app: public settings that identify the Firebase project. They are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional. The auth domain defaults to <project id>.firebaseapp.com.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=

# Local emulators (npm run emulators): uncomment these three lines instead of using a real project,
# and set FIREBASE_PROJECT_ID and VITE_FIREBASE_PROJECT_ID to demo-growth, VITE_FIREBASE_API_KEY to
# any text. To go back to a real project, comment all three out again: while one of them is active,
# sign-in and the database stay on the emulators whatever the project id says. The app's top bar
# says "Local emulator" while the web line is active.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
