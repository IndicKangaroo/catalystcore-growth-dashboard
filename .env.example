# Copy to .env for local development. Never commit .env or any key file.

NODE_ENV=development
PORT=8787

# Where the browser app is served from (used for CORS).
WEB_ORIGIN=http://localhost:5173

# Analytics source: "seed" (labeled demo data) or "ga4" (real GA4 Data API).
ANALYTICS_PROVIDER=seed

# Firebase (needed from phase P1 onward).
FIREBASE_PROJECT_ID=
# Local development only: path to a service account key file.
# In production on Cloud Run, leave this empty and use the runtime service account.
GOOGLE_APPLICATION_CREDENTIALS=

# Email of the first admin, used by the seed:admin script (phase P1).
ADMIN_EMAIL=
