{
  "name": "@growth/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "ga4:check": "tsx --env-file-if-exists=../../.env src/scripts/ga4Check.ts",
    "test:emulator": "vitest run --config vitest.emulator.config.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^5.0.0",
    "@growth/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  }
}
