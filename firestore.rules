rules_version = '2';

// Browsers never talk to Firestore directly. Every read and write goes through the API, which
// uses the Admin SDK and is not subject to these rules. So everything is denied here (D-022).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
